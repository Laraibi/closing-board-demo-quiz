# Copiez ce fichier en .env. Aucun secret réel dans Git.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lms-demo
# Clé de signature des jetons : une longue valeur aléatoire en production.
JWT_SECRET=changez-moi
# Envoi d'e-mails : laissez vide en local, les messages restent dans l'outbox.
SMTP_URL=
MAIL_FROM="LMS démo <no-reply@example.com>"
